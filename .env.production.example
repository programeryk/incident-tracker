NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN="https://incident-tracker.example.com"
DATABASE_URL="postgresql://postgres:replace-me@postgres:5432/incident_tracker?schema=public"
REDIS_URL="redis://redis:6379"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters-access"
JWT_REFRESH_SECRET="replace-with-at-least-32-random-characters-refresh"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-long-temporary-password"
STALE_INCIDENT_HOURS=24
POSTGRES_DB=incident_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
NEXT_PUBLIC_API_BASE_URL="https://api.incident-tracker.example.com"
